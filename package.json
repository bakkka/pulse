{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse — product analytics dashboard for SaaS teams",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "prisma generate && next build",
    "start": "next start -p 3200",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "prisma:postgres": "node scripts/prisma-postgres.mjs",
    "generate:postgres": "node scripts/prisma-postgres.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:postgres": "node scripts/prisma-postgres.mjs && prisma db push --schema prisma/schema.postgres.prisma",
    "db:seed:postgres": "node scripts/prisma-postgres.mjs && prisma generate --schema prisma/schema.postgres.prisma && tsx prisma/seed.ts",
    "vercel-build": "node scripts/prisma-postgres.mjs && prisma generate --schema prisma/schema.postgres.prisma && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
